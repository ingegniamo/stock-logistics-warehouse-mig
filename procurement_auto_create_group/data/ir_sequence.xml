<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- Odoo 19 dropped procurement.group and the sequence stock shipped with
         it, which this module used to name the group it created. -->
    <record id="seq_procurement_auto_create_group" model="ir.sequence">
        <field name="name">Automatic Stock Reference</field>
        <field name="code">procurement.auto.create.group</field>
        <field name="prefix">AUTO/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False" />
    </record>
</odoo>
